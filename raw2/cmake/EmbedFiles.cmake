# Transforme des fichiers binaires en tableaux C++ (aucun outil externe).
# Entrées : OUT (fichier .cpp produit), FILES (liste de chemins).
set(src "// Généré par cmake/EmbedFiles.cmake : ne pas éditer.\n#include <cstddef>\n\nnamespace raw2::embedded {\n")
set(index "")
set(i 0)
foreach(f ${FILES})
  get_filename_component(name ${f} NAME)
  file(READ ${f} hex HEX)
  string(LENGTH "${hex}" hexlen)
  math(EXPR size "${hexlen} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" bytes "${bytes}")
  string(APPEND src "static const unsigned char kData${i}[${size}] = {\n${bytes}\n};\n")
  string(APPEND index "  {\"${name}\", kData${i}, ${size}},\n")
  math(EXPR i "${i} + 1")
endforeach()
string(APPEND src "\nstruct File { const char* name; const unsigned char* data; size_t size; };\n")
string(APPEND src "extern const File kFiles[] = {\n${index}  {nullptr, nullptr, 0}\n};\n\n} // namespace raw2::embedded\n")
file(WRITE ${OUT} "${src}")
